---
import { Code } from "astro:components";
import ApiLayout from "../layouts/ApiLayout.astro";
import type { ApiPackage, Sdk } from "../data/sdks.ts";
import { renderDoc, renderParagraph } from "./api_doc.ts";

// One package of one SDK's reference. Rendered by
// src/pages/api/[...slug].astro for every package of every SDK.
interface Props {
  sdk: Sdk;
  pkg: ApiPackage;
}
const { sdk, pkg } = Astro.props;
const link = sdk.registry(pkg);

const kindLabel: Record<string, string> = {
  function: "function",
  class: "class",
  interface: "interface",
  typeAlias: "type",
  variable: "const",
  reference: "re-export",
  enum: "enum",
  namespace: "namespace",
};

const toc = [
  { id: "symbols", label: "Symbols" },
];
---

<ApiLayout
  sdk={sdk}
  title={pkg.name}
  description={pkg.summary}
  toc={toc}
>
  <p class="apiback" data-pagefind-ignore><a href={sdk.apiBase}>← {sdk.label} API reference</a></p>
  <p class="lead" set:html={renderParagraph(pkg.summary)} />
  <p class="apilinks">
    <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
    <span class="apilinks__count">{pkg.symbols.length} symbols</span>
  </p>

  <h2 id="symbols">Symbols</h2>
  <input
    type="text"
    id="pkgfilter"
    class="pkgfilter"
    placeholder={`Filter ${pkg.symbols.length} symbols by name or kind…`}
    autocomplete="off"
    spellcheck="false"
  />

  <div class="symlist" id="symlist">
    {pkg.symbols.map((sym) => (
      <section
        class="symcard"
        data-name={sym.name.toLowerCase()}
        data-kind={sym.kind.toLowerCase()}
      >
        <div class="symcard__head">
          <a class="symcard__anchor" href={`#${sym.name}`} aria-label={`Link to ${sym.name}`} data-pagefind-ignore>#</a>
          <!-- a real heading (with the id) so full-text search can deep-link
               to the symbol and list it as a sub-result of the package page -->
          <h3 class="symcard__name" id={sym.name}>{sym.name}</h3>
          <span class={`symbadge symbadge--${sym.kind}`}>
            {kindLabel[sym.kind] ?? sym.kind}
          </span>
          {sym.deprecated && <span class="symbadge symbadge--deprecated">deprecated</span>}
        </div>

        {sym.signature && (
          <Code code={sym.signature} lang={sdk.lang as Parameters<typeof Code>[0]["lang"]} theme="night-owl" />
        )}

        {sym.doc && <div class="symcard__doc" set:html={renderDoc(sym.doc)} />}

        {sym.members?.length ? (
          <ul class="members" aria-label={`${sym.name} members`}>
            {sym.members.map((m) => {
              // The signature already starts with the name (after any
              // static/async prefix), so emphasise it in place.
              const at = m.signature.indexOf(m.name);
              return (
                <li class="member">
                  <code class="member__sig">{at < 0 ? m.signature : (
                    <>{m.signature.slice(0, at)}<strong>{m.name}</strong>{m.signature.slice(at + m.name.length)}</>
                  )}</code>
                  {m.doc && <p class="member__doc" set:html={renderParagraph(m.doc)} />}
                </li>
              );
            })}
          </ul>
        ) : null}
      </section>
    ))}
  </div>
</ApiLayout>

<script>
  const input = document.getElementById("pkgfilter") as HTMLInputElement | null;
  const list = document.getElementById("symlist");
  if (input && list) {
    const cards = Array.from(list.querySelectorAll<HTMLElement>(".symcard"));
    input.addEventListener("input", () => {
      const needle = input.value.trim().toLowerCase();
      for (const card of cards) {
        const hit =
          !needle ||
          (card.dataset.name ?? "").includes(needle) ||
          (card.dataset.kind ?? "").includes(needle);
        card.hidden = !hit;
      }
    });
  }
</script>

<style>
  .apiback {
    margin: 0 0 6px;
    font-size: 0.88rem;
  }
  .apiback a {
    color: var(--text-faint);
  }
  .apilinks {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 8px;
    font-size: 0.9rem;
  }
  .apilinks__count {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .pkgfilter {
    display: block;
    width: 100%;
    max-width: 480px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 10px 14px;
    margin: 0 0 24px;
  }
  .pkgfilter:focus {
    outline: none;
    border-color: var(--accent);
  }

  .symlist {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .symcard {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 20px 18px;
  }
  .symcard:has(:target) {
    border-color: var(--accent);
  }
  .symcard__head {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .symcard__anchor {
    color: var(--text-faint);
    text-decoration: none;
    font-family: var(--font-mono);
  }
  .symcard__anchor:hover { color: var(--accent); }
  /* the heading is styled as an inline code name (the layout's h3 rule
     would otherwise give it prose margins and size) */
  .symcard h3.symcard__name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
    /* land the card (its padding + the head row) below the sticky header */
    scroll-margin-top: calc(var(--nav-h) + 40px);
  }

  .symbadge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
  }
  .symbadge--function, .symbadge--variable { color: var(--accent); border-color: color-mix(in oklch, var(--accent) 45%, var(--border-strong)); }
  .symbadge--class, .symbadge--interface { color: var(--ok); border-color: color-mix(in oklch, var(--ok) 45%, var(--border-strong)); }
  .symbadge--typeAlias { color: var(--warn); border-color: color-mix(in oklch, var(--warn) 45%, var(--border-strong)); }
  .symbadge--reference { color: var(--text-faint); }
  .symbadge--deprecated { color: var(--err); border-color: color-mix(in oklch, var(--err) 45%, var(--border-strong)); }

  .symcard__doc {
    margin-top: 12px;
    max-width: 82ch;
  }
  .symcard__doc :global(p) { color: var(--text-dim); margin: 0 0 10px; }
  .symcard__doc :global(p.doc-lead) { color: var(--ink); font-size: 1rem; }
  .symcard__doc :global(p:last-child) { margin-bottom: 0; }
  .symcard__doc :global(code) {
    background: color-mix(in oklch, var(--ink) 8%, transparent);
    padding: 2px 6px;
    border-radius: 5px;
    font-size: 0.86em;
  }
  .symcard__doc :global(.doc-pre) {
    background: var(--term-bg);
    border: 1px solid var(--term-border);
    border-radius: var(--radius);
    padding: 12px 14px;
    overflow-x: auto;
    margin: 10px 0;
  }
  .symcard__doc :global(.doc-pre code) {
    background: none;
    padding: 0;
    color: var(--term-ink);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .symcard :global(pre.astro-code) {
    margin: 10px 0 12px;
  }

  /* members: one per row, the full signature then its doc, so neither is
     squeezed into a narrow column */
  .members {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .member {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .member:last-child { border-bottom: 0; padding-bottom: 0; }
  .symcard code.member__sig {
    display: block;
    background: none;
    padding: 0;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.55;
    /* wrap at spaces; break inside a token only when one alone is too wide */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .member__sig strong { color: var(--ink); font-weight: 700; }
  .symcard .member__doc {
    margin: 4px 0 0;
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* compact screens: the sticky menu bar sits under the header too */
  @media (max-width: 860px) {
    .symcard h3.symcard__name { scroll-margin-top: calc(var(--nav-h) + 46px + 32px); }
  }
  @media (max-width: 600px) {
    .apilinks { flex-wrap: wrap; gap: 8px 14px; }
    .symcard { padding: 14px 14px 16px; }
    .symcard__name { overflow-wrap: anywhere; }
    .symcard__doc :global(.doc-pre) { padding: 10px 12px; }
  }
</style>
