---
/**
 * Full-text search over the docs and API reference.
 *
 * Renders the trigger (a faux input in the docs sidebar) and a modal
 * <dialog>. The index is built by Pagefind after `astro build`
 * (src/integrations/pagefind.ts) and loaded on demand from
 * /pagefind/pagefind.js the first time the dialog opens, so pages that never
 * search never pay for it.
 *
 * Shortcuts: ⌘K / Ctrl+K and "/" open, Esc closes, ↑/↓ move, ↵ opens a hit.
 */
---

<button
  type="button"
  class="search__btn"
  id="search-open"
  aria-label="Search docs and API"
  aria-haspopup="dialog"
  aria-controls="search-dialog"
  aria-keyshortcuts="Meta+K Control+K"
>
  <svg class="search__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="search__btn-label" aria-hidden="true">Search…</span>
  <kbd class="search__kbd" aria-hidden="true"><span data-mod>Ctrl</span> K</kbd>
</button>

<dialog class="search" id="search-dialog" aria-label="Search docs and API">
  <div class="search__panel" role="search">
    <div class="search__bar">
      <svg class="search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search__input"
        placeholder="Search docs and API…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-label="Search query"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="search__close" id="search-close" aria-label="Close search">
        <kbd aria-hidden="true">Esc</kbd>
      </button>
    </div>

    <div class="search__scope" role="radiogroup" aria-label="Search in">
      <label class="search__chip">
        <input type="radio" name="search-scope" value="" checked /> <span>All</span>
      </label>
      <label class="search__chip">
        <input type="radio" name="search-scope" value="Docs" /> <span>Docs</span>
      </label>
      <label class="search__chip">
        <input type="radio" name="search-scope" value="API" /> <span>API</span>
      </label>
    </div>

    <p class="search__status" id="search-status" role="status" aria-live="polite">
      Type to search every docs page and API symbol.
    </p>

    <ol class="search__results" id="search-results" role="listbox" aria-label="Results" hidden></ol>

    <div class="search__foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<script>
  // ---- Pagefind's browser API (loaded on demand) ----------------------
  interface PagefindSubResult {
    title: string;
    url: string;
    excerpt: string;
    weighted_locations: { weight: number; balanced_score: number; location: number }[];
  }
  interface PagefindData {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
    sub_results: PagefindSubResult[];
  }
  interface PagefindResult {
    id: string;
    data(): Promise<PagefindData>;
  }
  interface PagefindSearch {
    results: PagefindResult[];
  }
  interface Pagefind {
    init(): Promise<void>;
    options(o: Record<string, unknown>): Promise<void>;
    debouncedSearch(
      q: string,
      o?: { filters?: Record<string, string> },
      ms?: number,
    ): Promise<PagefindSearch | null>;
  }

  const dialog = document.getElementById("search-dialog") as HTMLDialogElement | null;
  const openBtn = document.getElementById("search-open");
  const closeBtn = document.getElementById("search-close");
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  const status = document.getElementById("search-status");
  const results = document.getElementById("search-results") as HTMLOListElement | null;

  if (dialog && openBtn && closeBtn && input && status && results && typeof dialog.showModal === "function") {
    const PAGE_SIZE = 10;
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform);
    const mod = openBtn.querySelector<HTMLElement>("[data-mod]");
    if (mod) mod.textContent = isMac ? "⌘" : "Ctrl";

    // ---- index loading ------------------------------------------------
    // Served from the build output, not bundled: kept out of Vite's graph by
    // importing through a variable (a literal specifier would be resolved
    // at build time, where the bundle doesn't exist yet).
    const bundleUrl = "/pagefind/pagefind.js";
    let pagefind: Promise<Pagefind> | null = null;
    const load = () => {
      if (!pagefind) {
        pagefind = import(/* @vite-ignore */ bundleUrl)
          .then(async (pf: Pagefind) => {
            await pf.options({ excerptLength: 24 });
            await pf.init();
            return pf;
          })
          .catch((err) => {
            pagefind = null; // allow a retry on the next keystroke
            throw err;
          });
      }
      return pagefind;
    };

    // ---- rendering ----------------------------------------------------
    const escapeHtml = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    // Pagefind's excerpts are plain text with only <mark> tags in them.
    const excerptHtml = (s: string) => s.replace(/<(?!\/?mark>)/g, "&lt;");

    let hits: PagefindData[] = [];
    let shown = 0;
    let active = -1;
    let searchSeq = 0;

    const options = () => Array.from(results.querySelectorAll<HTMLAnchorElement>(".search__hit"));

    const setActive = (i: number, scroll = true) => {
      const opts = options();
      active = opts.length ? Math.max(-1, Math.min(i, opts.length - 1)) : -1;
      opts.forEach((a, n) => {
        a.classList.toggle("is-active", n === active);
        a.setAttribute("aria-selected", String(n === active));
      });
      const a = opts[active];
      input.setAttribute("aria-activedescendant", a ? a.id : "");
      if (a && scroll) a.scrollIntoView({ block: "nearest" });
    };

    const renderHit = (hit: PagefindData, n: number) => {
      const title = hit.meta.title || hit.url;
      const section = hit.meta.section || "";
      // Pagefind lists sub-results in page order; show the headings that
      // match best. The region above the first heading carries the page
      // title, which the page-level row already covers — skip it.
      const score = (s: PagefindSubResult) =>
        s.weighted_locations.reduce((n, l) => n + (l.balanced_score || l.weight || 1), 0);
      const subs = hit.sub_results
        .filter((s) => s.title && s.title !== title)
        .sort((a, b) => score(b) - score(a))
        .slice(0, 3);
      const sub = subs
        .map(
          (s, i) => `
          <li>
            <a class="search__hit search__hit--sub" id="search-opt-${n}-${i + 1}" role="option" aria-selected="false" href="${escapeHtml(s.url)}" tabindex="-1">
              <span class="search__hit-title">${escapeHtml(s.title)}</span>
              <span class="search__hit-excerpt">${excerptHtml(s.excerpt)}</span>
            </a>
          </li>`,
        )
        .join("");
      return `
        <li class="search__page">
          <a class="search__hit" id="search-opt-${n}-0" role="option" aria-selected="false" href="${escapeHtml(hit.url)}" tabindex="-1">
            <span class="search__hit-head">
              <span class="search__hit-title">${escapeHtml(title)}</span>
              ${section ? `<span class="search__badge">${escapeHtml(section)}</span>` : ""}
            </span>
            <span class="search__hit-excerpt">${excerptHtml(hit.excerpt)}</span>
          </a>
          ${sub ? `<ul class="search__subs">${sub}</ul>` : ""}
        </li>`;
    };

    const renderMore = () => {
      const more = document.getElementById("search-more");
      if (more) more.remove();
      const rest = hits.length - shown;
      if (rest <= 0) return;
      const li = document.createElement("li");
      li.id = "search-more";
      li.className = "search__more";
      li.innerHTML = `<button type="button">Show ${Math.min(rest, PAGE_SIZE)} more of ${rest} remaining</button>`;
      li.querySelector("button")?.addEventListener("click", () => appendPage());
      results.appendChild(li);
    };

    const appendPage = () => {
      const from = shown;
      const to = Math.min(hits.length, shown + PAGE_SIZE);
      const html = hits.slice(from, to).map((h, i) => renderHit(h, from + i)).join("");
      document.getElementById("search-more")?.remove();
      results.insertAdjacentHTML("beforeend", html);
      shown = to;
      renderMore();
      if (from > 0) setActive(options().findIndex((a) => a.id === `search-opt-${from}-0`));
    };

    const clear = (message: string) => {
      hits = [];
      shown = 0;
      results.innerHTML = "";
      results.hidden = true;
      input.setAttribute("aria-expanded", "false");
      setActive(-1);
      status.textContent = message;
      status.hidden = false;
    };

    const scope = () =>
      (dialog.querySelector<HTMLInputElement>('input[name="search-scope"]:checked')?.value ?? "");

    const search = async () => {
      const q = input.value.trim();
      const seq = ++searchSeq;
      if (!q) {
        clear("Type to search every docs page and API symbol.");
        return;
      }
      let pf: Pagefind;
      try {
        pf = await load();
      } catch {
        clear(
          "The search index isn't available. It is generated by `npm run build`; " +
            "in development, run a build once and the dev server serves it from dist/.",
        );
        return;
      }
      const section = scope();
      const res = await pf.debouncedSearch(q, section ? { filters: { section } } : {}, 120);
      // null: superseded by a newer keystroke; seq: superseded by a scope change
      if (!res || seq !== searchSeq) return;

      const firstPage = await Promise.all(res.results.slice(0, PAGE_SIZE).map((r) => r.data()));
      if (seq !== searchSeq) return;
      // Resolve the rest lazily: `hits` only ever holds fetched data.
      hits = firstPage;
      shown = 0;
      results.innerHTML = "";
      const total = res.results.length;
      if (!total) {
        clear(`No results for “${q}”${section ? ` in ${section}` : ""}.`);
        return;
      }
      status.textContent = `${total} result${total === 1 ? "" : "s"} for “${q}”${section ? ` in ${section}` : ""}`;
      results.hidden = false;
      input.setAttribute("aria-expanded", "true");
      appendPage();
      setActive(0, false);

      if (total > PAGE_SIZE) {
        // Fetch the remaining pages' data in the background, then unlock "Show more".
        const rest = await Promise.all(res.results.slice(PAGE_SIZE).map((r) => r.data()));
        if (seq !== searchSeq) return;
        hits = [...firstPage, ...rest];
        renderMore();
      }
    };

    // ---- open / close -------------------------------------------------
    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      document.documentElement.classList.add("search-open");
      input.focus();
      input.select();
      // warm the index while the visitor types their first characters
      load().catch(() => {});
    };
    const close = () => {
      if (dialog.open) dialog.close();
    };
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("search-open");
    });
    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    // click on the backdrop (outside the panel) closes
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
    // a chosen result closes the dialog on its way out
    results.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) close();
    });

    document.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement | null;
      const typing =
        !!target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.tagName === "SELECT" ||
          target.isContentEditable);
      if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey) {
        e.preventDefault();
        dialog.open ? close() : open();
      } else if (e.key === "/" && !typing && !dialog.open && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        open();
      }
    });

    // ---- input & scope ------------------------------------------------
    input.addEventListener("input", () => void search());
    dialog.querySelectorAll<HTMLInputElement>('input[name="search-scope"]').forEach((r) =>
      r.addEventListener("change", () => {
        input.focus();
        void search();
      }),
    );

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === "Home" && options().length) {
        e.preventDefault();
        setActive(0);
      } else if (e.key === "End" && options().length) {
        e.preventDefault();
        setActive(options().length - 1);
      } else if (e.key === "Enter") {
        const opts = options();
        const a = opts[active >= 0 ? active : 0];
        if (a) {
          e.preventDefault();
          close();
          window.location.href = a.href;
        }
      }
    });
    // "Escape" on a type=search input first clears the value natively; make
    // it close the dialog outright, which is what people expect from ⌘K UIs.
    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      }
    });
  } else if (openBtn) {
    // no <dialog> support (or something missing): hide the trigger
    openBtn.hidden = true;
  }
</script>

<style>
  /* ---- trigger: a faux input in the sidebar ---------------- */
  .search__btn {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 8px 10px 8px 12px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--ink-faint);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .search__btn:hover { color: var(--ink-dim); border-color: var(--border-strong); }
  .search__btn-label { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .search__icon { flex: none; }
  /* without JS the dialog can't open: hide the trigger */
  :global(html:not(.js)) .search__btn { display: none; }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
    color: var(--ink-faint);
    background: var(--bg);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    padding: 3px 5px;
    white-space: nowrap;
  }
  .search__kbd { flex: none; }

  /* ---- dialog ---------------------------------------------- */
  :global(html.search-open) { overflow: hidden; }
  .search {
    width: min(680px, calc(100vw - 32px));
    max-height: min(78vh, 720px);
    margin: clamp(24px, 10vh, 96px) auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: var(--shadow-term), 0 0 0 1px oklch(0 0 0 / 0.25);
    overflow: hidden;
  }
  .search::backdrop {
    background: oklch(0.1 0.01 80 / 0.62);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .search[open] { animation: search-in 0.16s ease-out; }
  @keyframes search-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.99); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .search[open] { animation: none; }
  }
  .search__panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
    /* the dialog's max-height applies to the panel; results scroll inside */
    max-height: min(78vh, 720px);
  }

  .search__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px 12px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--ink-faint);
  }
  .search__bar .search__icon { color: var(--accent); }
  .search__input {
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: 0;
    padding: 6px 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1rem;
  }
  .search__input:focus { outline: none; }
  .search__input::placeholder { color: var(--ink-faint); }
  .search__input::-webkit-search-cancel-button { display: none; }
  .search__close {
    flex: none;
    display: inline-flex;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .search__close:hover kbd { color: var(--ink); border-color: var(--border-strong); }

  .search__scope {
    display: flex;
    gap: 6px;
    padding: 10px 16px 0;
  }
  .search__chip {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--ink-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 11px;
    cursor: pointer;
    user-select: none;
    transition: color 0.12s ease, border-color 0.12s ease, background 0.12s ease;
  }
  .search__chip:hover { color: var(--ink); border-color: var(--border-strong); }
  .search__chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .search__chip:has(input:checked) {
    color: var(--accent);
    border-color: color-mix(in oklch, var(--accent) 55%, var(--border-strong));
    background: var(--gradient-soft);
  }
  .search__chip:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .search__status {
    margin: 0;
    padding: 10px 16px 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  .search__status[hidden] { display: none; }

  /* ---- results ---------------------------------------------
     Rows are rendered at runtime (innerHTML), so they carry no scoped
     attribute: everything under .search__results is addressed globally. */
  .search__results {
    list-style: none;
    margin: 0;
    padding: 0 8px 8px;
    overflow-y: auto;
    overscroll-behavior: contain;
    flex: 1 1 auto;
    min-height: 0;
  }
  .search__results[hidden] { display: none; }
  .search__results :global(li) { list-style: none; }
  .search__results :global(.search__page + .search__page) { margin-top: 4px; }
  .search__results :global(.search__hit) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    color: inherit;
    text-decoration: none;
    transition: none;
  }
  .search__results :global(.search__hit:hover) { background: rgba(255,255,255,0.03); color: inherit; }
  .search__results :global(.search__hit.is-active) {
    background: var(--gradient-soft);
    border-left-color: var(--accent);
  }
  .search__results :global(.search__hit-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .search__results :global(.search__hit-title) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .search__results :global(.search__badge) {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid color-mix(in oklch, var(--accent) 45%, var(--border-strong));
    border-radius: 999px;
    padding: 1px 8px;
  }
  .search__results :global(.search__hit-excerpt) {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-dim);
    overflow-wrap: anywhere;
  }
  .search__results :global(mark) {
    background: transparent;
    color: var(--accent-strong);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--accent) 55%, transparent);
    text-underline-offset: 2px;
  }
  .search__results :global(.search__subs) {
    margin: 2px 0 4px 14px;
    padding: 0 0 0 10px;
    border-left: 1px solid var(--border);
  }
  .search__results :global(.search__hit--sub) { padding: 6px 10px; gap: 2px; }
  .search__results :global(.search__hit--sub .search__hit-title) { font-size: 0.82rem; font-weight: 600; color: var(--ink-dim); }
  .search__results :global(.search__hit--sub .search__hit-title::before) { content: "# "; color: var(--ink-faint); font-weight: 400; }
  .search__results :global(.search__hit--sub.is-active .search__hit-title) { color: var(--ink); }
  .search__results :global(.search__hit--sub .search__hit-excerpt) { font-size: 0.8rem; }

  .search__results :global(.search__more) { padding: 6px 10px 4px; }
  .search__results :global(.search__more button) {
    width: 100%;
    padding: 8px 12px;
    background: transparent;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    cursor: pointer;
  }
  .search__results :global(.search__more button:hover) { color: var(--ink); border-color: var(--accent); }

  .search__foot {
    display: flex;
    gap: 16px;
    padding: 8px 16px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    background: var(--panel);
  }
  .search__foot span { display: inline-flex; align-items: center; gap: 4px; }

  @media (max-width: 600px) {
    .search {
      width: calc(100vw - 16px);
      max-height: calc(100dvh - 16px);
      margin: 8px auto auto;
    }
    .search__panel { max-height: calc(100dvh - 16px); }
    .search__bar { padding: 10px 12px; }
    .search__input { font-size: 16px; } /* iOS: no zoom-on-focus below 16px */
    .search__foot { display: none; }
    .search__scope, .search__status { padding-inline: 12px; }
  }
</style>
