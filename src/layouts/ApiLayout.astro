---
import DocsLayout from "./DocsLayout.astro";
import { sdks, type Sdk } from "../data/sdks.ts";

interface Props {
  sdk: Sdk;
  title: string;
  description?: string;
  toc?: { id: string; label: string }[];
}
const { sdk, title, description, toc = [] } = Astro.props;

// Standalone API section: same three-column layout as docs, but the sidebar
// lists one overview per SDK and the current SDK's generated packages.
const nav = [
  {
    group: "API reference",
    items: sdks.map((s) => ({ href: s.apiBase, label: s.label })),
  },
  {
    group: `${sdk.label} packages`,
    items: sdk.api.packages.map((pkg) => ({
      href: `${sdk.apiBase}/${pkg.dir}`,
      label: pkg.name,
    })),
  },
  {
    group: "More",
    items: [
      { href: sdk.docs[0]?.href ?? "/docs", label: `${sdk.label} docs` },
      { href: "/examples", label: "Examples" },
      sdk.registryHome,
    ],
  },
];
---

<DocsLayout title={title} description={description} toc={toc} nav={nav} suffix={`Zuke ${sdk.label} API`} section="API">
  <slot />
</DocsLayout>
